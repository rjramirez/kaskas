{
  "manifest_version": "1.0",
  "skill": {
    "id": "kaskas",
    "name": "Kaskas",
    "version": "4.0.0",
    "description": "Portable financial memory workflow for reviewing credit card statements, tracking obligations, detecting subscriptions, analyzing utilization, and optimizing cashback usage",
    "author": {
      "name": "rjramirez",
      "url": "https://github.com/rjramirez"
    },
    "license": "MIT",
    "repository": "https://github.com/rjramirez/kaskas",
    "homepage": "https://github.com/rjramirez/kaskas",
    "keywords": [
      "finance",
      "credit-cards",
      "budgeting",
      "subscriptions",
      "cashback",
      "portable-memory",
      "caveman",
      "pinoy",
      "philippines",
      "filipino"
    ],
    "categories": [
      "finance",
      "productivity",
      "analysis"
    ]
  },
  "interface": {
    "display_name": "Kaskas",
    "short_description": "Financial memory workflow",
    "description": "Review statements, track obligations, detect subscriptions, and optimize card usage. Made for Pinoys!",
    "icon": "💰",
    "color": "#22c55e",
    "theme": "light"
  },
  "commands": [
    {
      "id": "kaskas",
      "name": "Kaskas",
      "description": "Show all Kaskas commands, status, and quick start guide",
      "icon": "💰",
      "handler": "commands/kaskas.md",
      "resources": []
    },
    {
      "id": "review",
      "name": "Review",
      "description": "Analyze credit card statements, receipts, and transactions",
      "icon": "📊",
      "handler": "commands/review.md",
      "resources": [
        "references/merchant-categories.md",
        "references/ph-expressions.md",
        "references/ph-spending-patterns.md",
        "templates/summary.md",
        "schemas/transaction.schema.json"
      ]
    },
    {
      "id": "due",
      "name": "Due",
      "description": "Track credit card dues, subscriptions, and recurring bills",
      "icon": "⏰",
      "handler": "commands/due.md",
      "resources": [
        "templates/obligations.md",
        "references/ph-calendar.md",
        "references/ph-expressions.md",
        "schemas/obligation.schema.json"
      ]
    },
    {
      "id": "subscriptions",
      "name": "Subscriptions",
      "description": "Detect recurring charges and subscription patterns",
      "icon": "🔄",
      "handler": "commands/subscriptions.md",
      "resources": [
        "references/recurring-patterns.md",
        "schemas/transaction.schema.json"
      ]
    },
    {
      "id": "offers",
      "name": "Offers",
      "description": "Find best card offers and cashback opportunities",
      "icon": "💳",
      "handler": "commands/offers.md",
      "resources": [
        "references/ph-cards.md",
        "references/ph-promos.md",
        "schemas/promo.schema.json"
      ]
    },
    {
      "id": "safe",
      "name": "Safe",
      "description": "Check safe spending limits and utilization risk",
      "icon": "🛡️",
      "handler": "commands/safe.md",
      "resources": []
    },
    {
      "id": "export",
      "name": "Export",
      "description": "Export financial memory as JSON, CSV, or Markdown",
      "icon": "📤",
      "handler": "commands/export.md",
      "resources": [
        "schemas/transaction.schema.json",
        "schemas/obligation.schema.json"
      ]
    },
    {
      "id": "ocr",
      "name": "OCR",
      "description": "Extract text from images, screenshots, and receipts",
      "icon": "📸",
      "handler": "commands/ocr.md",
      "resources": [
        "schemas/transaction.schema.json"
      ]
    },
    {
      "id": "pdf",
      "name": "PDF",
      "description": "Extract transactions from PDF statements",
      "icon": "📄",
      "handler": "commands/pdf.md",
      "resources": [
        "schemas/transaction.schema.json"
      ]
    },
    {
      "id": "promos",
      "name": "Promos",
      "description": "Parse promotional offers and card rewards",
      "icon": "🎁",
      "handler": "commands/promos.md",
      "resources": [
        "references/ph-promos.md",
        "references/ph-calendar.md",
        "schemas/promo.schema.json"
      ]
    },
    {
      "id": "memory",
      "name": "Memory",
      "description": "Store and retrieve financial data from local SQLite database",
      "icon": "💾",
      "handler": "commands/memory.md",
      "resources": [
        "schemas/memory.schema.json"
      ]
    },
    {
      "id": "embed",
      "name": "Embed",
      "description": "Generate embeddings and perform semantic search",
      "icon": "🔍",
      "handler": "commands/embed.md",
      "resources": [
        "schemas/embedding.schema.json",
        "references/embedding-config.md"
      ]
    },
    {
      "id": "insights",
      "name": "Insights",
      "description": "Semantic analysis and intelligent financial insights",
      "icon": "💡",
      "handler": "commands/insights.md",
      "resources": [
        "schemas/memory.schema.json",
        "schemas/embedding.schema.json"
      ]
    },
    {
      "id": "llm",
      "name": "LLM",
      "description": "Run local LLM for financial analysis and questions",
      "icon": "🧠",
      "handler": "commands/llm.md",
      "resources": [
        "references/llm-config.md"
      ]
    },
    {
      "id": "remind",
      "name": "Remind",
      "description": "Proactive reminders and smart notifications",
      "icon": "🔔",
      "handler": "commands/remind.md",
      "resources": [
        "references/ph-calendar.md",
        "references/ph-expressions.md",
        "schemas/reminder.schema.json"
      ]
    },
    {
      "id": "forecast",
      "name": "Forecast",
      "description": "Financial forecasting and spending predictions",
      "icon": "📈",
      "handler": "commands/forecast.md",
      "resources": [
        "schemas/forecast.schema.json",
        "references/forecast-config.md",
        "references/ph-calendar.md",
        "references/ph-spending-patterns.md"
      ]
    }
  ],
  "resources": {
    "base_path": "./",
    "directories": {
      "commands": "commands/",
      "references": "references/",
      "templates": "templates/",
      "schemas": "schemas/",
      "data": "data/"
    }
  },
  "configuration": {
    "token_efficiency": "high",
    "philosophy": "caveman",
    "output_format": "markdown",
    "data_ownership": "user-first",
    "cache_resources": true,
    "validate_schemas": true,
    "locale": {
      "language": "en",
      "taglish": false,
      "currency": "PHP",
      "currency_symbol": "₱"
    },
    "security": {
      "requires_authentication": false,
      "data_storage": "local-only",
      "data_export": true
    }
  },
  "dependencies": [],
  "installation": {
    "windows": {
      "path": "%APPDATA%\\Claude\\skills\\kaskas",
      "script": "install.ps1"
    },
    "macos": {
      "path": "~/Library/Application Support/Claude/skills/kaskas",
      "script": "install.sh"
    },
    "linux": {
      "path": "~/.config/Claude/skills/kaskas",
      "script": "install.sh"
    }
  }
}
