{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Embedding",
  "type": "object",
  "required": ["id", "text", "vector", "type"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique embedding ID (UUID)",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "text": {
      "type": "string",
      "description": "Original text that was embedded",
      "minLength": 1
    },
    "vector": {
      "type": "array",
      "description": "Embedding vector (1536 dimensions for text-embedding-3-small)",
      "items": {
        "type": "number"
      },
      "minItems": 1536,
      "maxItems": 1536
    },
    "type": {
      "type": "string",
      "description": "Embedding type",
      "enum": ["merchant", "category", "description", "obligation_type"]
    },
    "record_id": {
      "type": "string",
      "description": "Reference to memory record ID",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "model": {
      "type": "string",
      "description": "Embedding model used",
      "default": "text-embedding-3-small"
    },
    "created_at": {
      "type": "string",
      "description": "Creation timestamp (ISO 8601)",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
