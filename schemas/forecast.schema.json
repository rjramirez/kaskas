{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Forecast",
  "type": "object",
  "required": ["id", "type", "period", "generated_at"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique forecast ID (UUID)",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "type": {
      "type": "string",
      "description": "Forecast type",
      "enum": ["category", "total", "obligation", "subscription"]
    },
    "period": {
      "type": "string",
      "description": "Forecast period",
      "enum": ["month", "quarter", "year"]
    },
    "start_date": {
      "type": "string",
      "description": "Forecast start date (YYYY-MM-DD)",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "end_date": {
      "type": "string",
      "description": "Forecast end date (YYYY-MM-DD)",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "forecasts": {
      "type": "array",
      "description": "Forecast data points",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "Date (YYYY-MM-DD)",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "value": {
            "type": "number",
            "description": "Forecasted value"
          },
          "lower_bound": {
            "type": "number",
            "description": "95% confidence lower bound"
          },
          "upper_bound": {
            "type": "number",
            "description": "95% confidence upper bound"
          },
          "confidence": {
            "type": "number",
            "description": "Confidence score (0-1)",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "model": {
      "type": "string",
      "description": "Forecasting model used",
      "enum": ["linear_regression", "exponential_smoothing", "arima", "prophet"]
    },
    "accuracy_metrics": {
      "type": "object",
      "description": "Model accuracy metrics",
      "properties": {
        "mae": {
          "type": "number",
          "description": "Mean Absolute Error"
        },
        "rmse": {
          "type": "number",
          "description": "Root Mean Square Error"
        },
        "mape": {
          "type": "number",
          "description": "Mean Absolute Percentage Error"
        }
      }
    },
    "generated_at": {
      "type": "string",
      "description": "Generation timestamp (ISO 8601)",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
