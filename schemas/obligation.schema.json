{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Obligation",
  "type": "object",
  "required": ["type", "amount", "due_date"],
  "properties": {
    "type": {
      "type": "string",
      "description": "Obligation type",
      "enum": ["credit_card", "subscription", "loan", "bill", "installment", "other"]
    },
    "amount": {
      "type": "number",
      "description": "Obligation amount in PHP",
      "minimum": 0
    },
    "due_date": {
      "type": "string",
      "description": "Due date in YYYY-MM-DD format",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "frequency": {
      "type": "string",
      "description": "Payment frequency",
      "enum": ["one-time", "weekly", "bi-weekly", "monthly", "quarterly", "semi-annual", "annual"]
    },
    "merchant": {
      "type": "string",
      "description": "Merchant or creditor name"
    },
    "description": {
      "type": "string",
      "description": "Optional description or notes"
    },
    "status": {
      "type": "string",
      "description": "Payment status",
      "enum": ["pending", "paid", "overdue", "partial"]
    },
    "start_date": {
      "type": "string",
      "description": "When obligation started (YYYY-MM-DD)",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "end_date": {
      "type": "string",
      "description": "When obligation ends, if applicable (YYYY-MM-DD)",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "additionalProperties": false
}
